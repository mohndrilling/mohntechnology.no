# Contact form API URL (injected into Astro at dev-start / image build).
# DEV behind docker-compose.dev.yml (Caddy :80) — relative = works on LAN IP too:
PUBLIC_CONTACT_API_URL=/api/contact

# Production image build (Server / CI):
# PUBLIC_CONTACT_API_URL=https://mohntechnology.no/api/contact

# contactapi CORS (comma-separated). Add your LAN IP when sharing DEV:
ALLOW_ORIGINS=http://127.0.0.1,http://localhost,http://192.168.10.124
MAIL_TO=dev@example.com

# Leave SMTP_HOST empty to log contacts to container stdout
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

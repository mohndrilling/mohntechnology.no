# Static Astro site → nginx
# Build from repo root:
#   docker build -f docker/Dockerfile.web \
#     --build-arg PUBLIC_CONTACT_API_URL=https://mohntechnology.no/api/contact \
#     -t docker.mohntechnology.no/mohntechnology.no:latest .

FROM node:22-bookworm AS build
WORKDIR /app

ARG PUBLIC_CONTACT_API_URL=https://mohntechnology.no/api/contact
ENV PUBLIC_CONTACT_API_URL=$PUBLIC_CONTACT_API_URL
ENV ASTRO_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

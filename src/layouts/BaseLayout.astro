---
interface Props {
	title: string;
	description?: string;
	lang: 'en' | 'no';
	brand?: 'mohn' | 'salmoscan';
}
const {
	title,
	description = 'Mohn Technology – underwater technology and machine vision.',
	lang = 'en',
	brand = 'mohn',
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..700;1,400..700&family=Syne:wght@500..800&display=swap"
			rel="stylesheet"
		/>
		<script is:inline define:vars={{ brand }}>
			(function () {
				if (brand === 'mohn') {
					document.documentElement.setAttribute('data-theme', 'dark');
					return;
				}
				var s = localStorage.getItem('theme');
				if (!s) s = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.setAttribute('data-theme', s);
			})();
		</script>
		<style is:global>
			:root,
			[data-theme='dark'] {
				--color-bg: #071018;
				--color-surface: #0f1c28;
				--color-surface-elevated: #162636;
				--color-text: #e7eef4;
				--color-text-muted: #8fa3b5;
				--color-accent: #2eb8a6;
				--color-accent-hover: #4fd4c2;
				--color-accent-dim: rgba(46, 184, 166, 0.16);
				--color-border: rgba(231, 238, 244, 0.1);
				--font-heading: 'Syne', sans-serif;
				--font-body: 'Figtree', sans-serif;
				--radius: 10px;
				--radius-lg: 18px;
				--container: min(1320px, 100% - clamp(2rem, 5vw, 4rem));
				--header-h: 4.5rem;
				--header-bg: rgba(7, 16, 24, 0.88);
				--hero-veil: linear-gradient(105deg, rgba(7, 16, 24, 0.92) 0%, rgba(7, 16, 24, 0.55) 48%, rgba(7, 16, 24, 0.25) 100%);
			}
			[data-theme='light'] {
				--color-bg: #f3f6f8;
				--color-surface: #ffffff;
				--color-surface-elevated: #e8eef2;
				--color-text: #0c1a24;
				--color-text-muted: #4a5f70;
				--color-accent: #0f766e;
				--color-accent-hover: #0d9488;
				--color-accent-dim: rgba(15, 118, 110, 0.12);
				--color-border: rgba(12, 26, 36, 0.1);
				--header-bg: rgba(243, 246, 248, 0.92);
				--hero-veil: linear-gradient(105deg, rgba(243, 246, 248, 0.95) 0%, rgba(243, 246, 248, 0.7) 45%, rgba(243, 246, 248, 0.2) 100%);
			}
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
			}
			body {
				margin: 0;
				font-family: var(--font-body);
				font-size: 1rem;
				line-height: 1.6;
				color: var(--color-text);
				background: var(--color-bg);
				-webkit-font-smoothing: antialiased;
			}
			a {
				color: var(--color-accent);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			img {
				max-width: 100%;
				height: auto;
			}
		</style>
	</head>
	<body data-brand={brand}>
		<slot />
		<script is:inline>
			(function () {
				const key = 'theme';
				const isMohn = document.body.getAttribute('data-brand') === 'mohn';
				if (isMohn) {
					document.documentElement.dataset.theme = 'dark';
					return;
				}
				const stored = localStorage.getItem(key);
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');

				document.addEventListener('DOMContentLoaded', function () {
					const btn = document.getElementById('theme-toggle');
					if (!btn) return;
					btn.addEventListener('click', function () {
						const root = document.documentElement;
						const next = root.dataset.theme === 'light' ? 'dark' : 'light';
						root.dataset.theme = next;
						localStorage.setItem(key, next);
					});
				});
			})();
		</script>
	</body>
</html>

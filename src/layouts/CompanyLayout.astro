---
import LocaleThemeControls from '../components/LocaleThemeControls.astro';
import { getCompanyHome } from '../lib/companyContent';
import { productPath, productSlugFromName } from '../lib/productPaths';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: 'en' | 'no';
	/** When false, skip the layout top bar (company home has its own sticky header). */
	showSiteHeader?: boolean;
	/** Override language switch target (defaults to the other locale home). */
	alternateLangHref?: string;
}

const { title, description, lang, showSiteHeader = true, alternateLangHref } = Astro.props;
const home = await getCompanyHome(lang);
const data = home.data;

const homePath = lang === 'no' ? '/no/' : '/';
const homeLabel = lang === 'no' ? 'Hjem' : 'Home';
const mainNavLabel = lang === 'no' ? 'Hovedmeny' : 'Main navigation';
const menuLabel = lang === 'no' ? 'Meny' : 'Menu';
const marketsLabel = lang === 'no' ? 'Markeder' : 'Markets';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const linkToEn = lang === 'en' ? currentPath : (alternateLangHref ?? '/');
const linkToNo = lang === 'no' ? currentPath : (alternateLangHref ?? '/no/');

const mainNav = [
	{ href: homePath, label: homeLabel },
	{ href: `${homePath}#deliver`, label: data.navDeliver },
	{ href: `${homePath}#work`, label: data.navProjects },
	{ href: `${homePath}#about`, label: data.navAbout },
	{ href: `${homePath}#contact`, label: data.navContact },
];

const marketsWithHref = data.deliverMarkets.map((market) => ({
	...market,
	href: productPath(lang, productSlugFromName(market.product)),
}));
const productsWithHref = data.products.map((product) => ({
	...product,
	href: productPath(lang, product.slug),
}));

function resolveHref(href: string) {
	if (href.startsWith('http') || href.startsWith('/')) return href;
	if (href.startsWith('#')) return `${homePath}${href}`;
	return href;
}

const linkedInUrl = data.footerLinkedInUrl?.trim() || '';
---
<BaseLayout title={title} description={description} lang={lang} brand="mohn">
	{
		showSiteHeader && (
			<header class="mt-header" data-header>
				<div class="container mt-header-inner">
					<a href={homePath} class="mt-logo" aria-label={data.footerBrand}>
						<img
							src="/media/company/brand/mohn-technology-logo.png"
							alt={data.footerBrand}
							width="963"
							height="670"
							decoding="async"
							fetchpriority="high"
						/>
					</a>

					<nav class="mt-nav" aria-label={mainNavLabel}>
						<div class="mt-tablist">
							{mainNav.map((item) => (
								<a class="mt-nav-link" href={item.href}>
									{item.label}
								</a>
							))}
						</div>
					</nav>

					<div class="mt-header-tools">
						<LocaleThemeControls locale={lang} linkToEn={linkToEn} linkToNo={linkToNo} showTheme={false} />
						<button
							type="button"
							class="mt-menu-toggle"
							data-site-menu-toggle
							aria-expanded="false"
							aria-controls="site-top-mobile-nav"
						>
							{menuLabel}
						</button>
					</div>
				</div>

				<div class="mt-mobile-nav container" id="site-top-mobile-nav" data-site-mobile-nav hidden>
					<a class="mt-mobile-link" href={homePath}>
						{homeLabel}
					</a>
					<a class="mt-mobile-link" href={`${homePath}#deliver`}>
						{data.navDeliver}
					</a>
					<p class="mt-mobile-group">{marketsLabel}</p>
					{marketsWithHref.map((market) => (
						<a class="mt-mobile-link mt-mobile-sub" href={market.href}>
							{market.title}
						</a>
					))}
					<p class="mt-mobile-group">{data.navProductsColumn}</p>
					{productsWithHref.map((product) => (
						<a class="mt-mobile-link mt-mobile-sub" href={product.href}>
							{product.title}
						</a>
					))}
					<a class="mt-mobile-link" href={`${homePath}#work`}>
						{data.navProjects}
					</a>
					<a class="mt-mobile-link" href={`${homePath}#about`}>
						{data.navAbout}
					</a>
					<a class="mt-mobile-link" href={`${homePath}#contact`}>
						{data.navContact}
					</a>
				</div>
			</header>
		)
	}
	<slot />

	<footer class="site-footer">
		<div class="container site-footer-inner">
			<div class="site-footer-top">
				<div class="site-footer-brand">
					<p class="site-footer-logo">{data.footerBrand}</p>
					<a class="site-footer-email" href={`mailto:${data.contactEmail}`}>{data.contactEmail}</a>
					<address class="site-footer-address">
						{data.addressLines.map((line) => (
							<span>{line}</span>
						))}
					</address>
				</div>
			</div>

			<div class="site-footer-bottom">
				<ul class="site-footer-legal">
					{data.footerLegal.map((item) => (
						<li>
							<a href={resolveHref(item.href)}>{item.label}</a>
						</li>
					))}
				</ul>
				<div class="site-footer-meta">
					{
						linkedInUrl ? (
							<p class="site-footer-social">
								<a href={linkedInUrl} target="_blank" rel="noopener noreferrer">
									{data.footerLinkedInLabel}
								</a>
							</p>
						) : null
					}
					<p class="site-footer-copy">{data.footerCopy}</p>
				</div>
			</div>
		</div>
	</footer>

	<style is:global>
		.container {
			width: var(--container);
			max-width: 100%;
			margin-inline: auto;
			padding-inline: clamp(1rem, 4vw, 3rem);
		}

		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.6rem 1.25rem;
			font-family: var(--font-body);
			font-weight: 600;
			font-size: 0.95rem;
			border-radius: var(--radius);
			border: none;
			cursor: pointer;
			text-decoration: none;
			transition: background 0.2s, color 0.2s, box-shadow 0.2s;
		}
		.btn-primary {
			background: var(--color-accent);
			color: var(--color-bg);
		}
		.btn-primary:hover {
			background: var(--color-accent-hover);
			text-decoration: none;
		}
		.btn-ghost {
			background: transparent;
			color: var(--color-text);
			border: 1px solid var(--color-border);
		}
		.btn-ghost:hover {
			background: var(--color-surface-elevated);
			text-decoration: none;
			border-color: var(--color-text-muted);
		}

		.section-title {
			font-family: var(--font-heading);
			font-weight: 700;
			font-size: clamp(1.85rem, 3.4vw, 2.55rem);
			margin: 0 0 0.5rem;
			letter-spacing: -0.02em;
		}
		.section-lead {
			color: var(--color-text-muted);
			font-size: clamp(1.08rem, 1.4vw, 1.18rem);
			margin: 0 0 1.75rem;
			max-width: min(46rem, 100%);
		}

		.mt-header {
			position: sticky;
			top: 0;
			z-index: 100;
			background: var(--header-bg);
			backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--color-border);
		}
		.mt-header-inner {
			display: grid;
			grid-template-columns: auto 1fr auto;
			align-items: center;
			gap: 1rem 1.5rem;
			min-height: 4rem;
		}
		.mt-logo {
			display: inline-flex;
			align-items: center;
			text-decoration: none;
			line-height: 0;
		}
		.mt-logo img {
			display: block;
			height: clamp(3.1rem, 5.5vw, 3.75rem);
			width: auto;
			image-rendering: -webkit-optimize-contrast;
		}
		.mt-logo:hover {
			opacity: 0.88;
			text-decoration: none;
		}
		[data-theme='light'] .mt-logo img {
			filter: invert(1);
		}
		.mt-nav {
			display: none;
			justify-content: center;
		}
		@media (min-width: 960px) {
			.mt-nav {
				display: flex;
			}
			.mt-menu-toggle {
				display: none;
			}
		}
		.mt-tablist {
			display: flex;
			align-items: center;
			gap: 0.15rem;
			flex-wrap: wrap;
			justify-content: center;
		}
		.mt-nav-link {
			appearance: none;
			border: none;
			background: transparent;
			color: var(--color-text-muted);
			font-family: var(--font-body);
			font-size: 0.95rem;
			font-weight: 500;
			padding: 0.55rem 0.75rem;
			border-radius: 0;
			cursor: pointer;
			position: relative;
			text-decoration: none;
		}
		.mt-nav-link:hover {
			color: var(--color-text);
			text-decoration: none;
		}
		.mt-nav-link.is-active {
			color: var(--color-text);
			font-weight: 600;
		}
		.mt-nav-link::after {
			content: '';
			position: absolute;
			left: 0.75rem;
			right: 0.75rem;
			bottom: 0.2rem;
			height: 2px;
			background: var(--color-accent);
			border-radius: 1px;
			transform: scaleX(0);
			transition: transform 0.25s ease;
		}
		.mt-nav-link.is-active::after {
			transform: scaleX(1);
		}
		.mt-header-tools {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			justify-self: end;
		}
		.mt-menu-toggle {
			appearance: none;
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			color: var(--color-text);
			font-family: var(--font-body);
			font-size: 0.9rem;
			font-weight: 600;
			padding: 0.45rem 0.75rem;
			border-radius: var(--radius);
			cursor: pointer;
		}
		.mt-mobile-nav {
			display: flex;
			flex-direction: column;
			gap: 0.05rem;
			padding: 0.35rem 0 0.85rem;
			border-top: 1px solid var(--color-border);
		}
		.mt-mobile-nav[hidden] {
			display: none;
		}
		@media (min-width: 960px) {
			.mt-mobile-nav {
				display: none !important;
			}
		}
		.mt-mobile-group {
			margin: 0.7rem 0 0.15rem;
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--color-text-muted);
		}
		.mt-mobile-link {
			appearance: none;
			border: none;
			background: transparent;
			text-align: left;
			color: var(--color-text-muted);
			font-family: var(--font-body);
			font-size: 1rem;
			font-weight: 500;
			padding: 0.7rem 0.15rem;
			cursor: pointer;
			border-bottom: 1px solid var(--color-border);
			text-decoration: none;
		}
		.mt-mobile-sub {
			font-size: 0.95rem;
			padding-left: 0.75rem;
		}
		.mt-mobile-link:hover {
			color: var(--color-text);
			text-decoration: none;
		}
		@media (max-width: 640px) {
			.mt-header-inner {
				grid-template-columns: 1fr auto;
			}
		}

		.site-footer {
			margin-top: 3rem;
			padding: clamp(2.75rem, 6vw, 4.5rem) 0 clamp(1.75rem, 4vw, 2.5rem);
			background: #14202a;
			color: #e8eef3;
		}
		[data-theme='light'] .site-footer {
			background: #1a2833;
			color: #e8eef3;
		}
		.site-footer a {
			color: inherit;
			text-decoration: underline;
			text-underline-offset: 0.18em;
			text-decoration-thickness: 1px;
		}
		.site-footer a:hover {
			color: var(--color-accent-hover);
		}
		.site-footer-top {
			display: flex;
			flex-wrap: wrap;
			justify-content: flex-start;
			gap: 2.5rem 3rem;
			margin-bottom: clamp(2.5rem, 6vw, 4rem);
		}
		.site-footer-brand {
			text-align: left;
			max-width: 22rem;
		}
		.site-footer-logo {
			margin: 0 0 0.85rem;
			font-family: var(--font-heading);
			font-size: clamp(1.45rem, 2.5vw, 1.85rem);
			font-weight: 700;
			letter-spacing: -0.03em;
		}
		.site-footer-email {
			display: inline-block;
			margin-bottom: 0.55rem;
			font-size: 0.98rem;
		}
		.site-footer-address {
			display: grid;
			gap: 0.15rem;
			font-style: normal;
			font-size: 0.92rem;
			line-height: 1.45;
			opacity: 0.85;
		}
		.site-footer-bottom {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: flex-end;
			gap: 1.25rem 2rem;
		}
		.site-footer-legal {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.65rem 1.25rem;
			font-size: 0.9rem;
		}
		.site-footer-meta {
			text-align: left;
		}
		.site-footer-social {
			margin: 0 0 0.45rem;
			font-size: 0.9rem;
		}
		.site-footer-copy {
			margin: 0;
			font-size: 0.82rem;
			opacity: 0.7;
		}

		@media (max-width: 720px) {
			.site-footer-brand,
			.site-footer-meta {
				text-align: left;
			}
		}

		.legal-page {
			padding: 2.5rem 0 1rem;
			max-width: 46rem;
		}
		.legal-draft {
			margin: 0 0 1.5rem;
			padding: 0.85rem 1rem;
			border-left: 3px solid var(--color-accent);
			background: var(--color-surface);
			color: var(--color-text-muted);
			font-size: 0.95rem;
			line-height: 1.5;
		}
		.legal-updated {
			margin: 0 0 1.75rem;
			color: var(--color-text-muted);
			font-size: 0.9rem;
		}
		.legal-body :global(h2) {
			font-family: var(--font-heading);
			font-size: 1.25rem;
			margin: 2rem 0 0.65rem;
		}
		.legal-body :global(h3) {
			font-family: var(--font-heading);
			font-size: 1.05rem;
			margin: 1.5rem 0 0.5rem;
		}
		.legal-body :global(p),
		.legal-body :global(li) {
			color: var(--color-text-muted);
			line-height: 1.6;
		}
		.legal-body :global(ul) {
			padding-left: 1.2rem;
		}
		.legal-body :global(a) {
			color: var(--color-accent);
		}
	</style>

	<script>
		const toggle = document.querySelector('[data-site-menu-toggle]');
		const mobileNav = document.querySelector('[data-site-mobile-nav]');
		if (toggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
			toggle.addEventListener('click', () => {
				const open = mobileNav.hasAttribute('hidden');
				if (open) {
					mobileNav.removeAttribute('hidden');
					toggle.setAttribute('aria-expanded', 'true');
				} else {
					mobileNav.setAttribute('hidden', '');
					toggle.setAttribute('aria-expanded', 'false');
				}
			});
		}
	</script>
</BaseLayout>

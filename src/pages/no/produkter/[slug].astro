---
import { getCollection } from 'astro:content';
import ProductPage from '../../../components/ProductPage.astro';
import { productPath } from '../../../lib/productPaths';

export async function getStaticPaths() {
	const entries = await getCollection('products', ({ data }) => data.lang === 'no');
	return entries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const alternateLangHref = productPath('en', entry.data.slug);
---
<ProductPage lang="no" alternateLangHref={alternateLangHref} data={entry.data} />

---
import CompanyLayout from '../../layouts/CompanyLayout.astro';
import CompanyHome from '../../components/CompanyHome.astro';
import { getCompanyHome } from '../../lib/companyContent';

const locale = 'no';
const page = await getCompanyHome(locale);
const data = page.data;

const formLabels = {
	name: 'Navn',
	email: 'E-post',
	message: 'Melding',
	submit: 'Send melding',
	placeholderName: 'Ditt navn',
	placeholderEmail: 'deg@firma.no',
	placeholderMessage: 'Beskriv anlegg, fartøy, elv eller spørsmål…',
};
---
<CompanyLayout
	title={data.title}
	description={data.description}
	lang={locale}
	showSiteHeader={false}
>
	<CompanyHome
		lang={locale}
		homePath="/no/"
		navDeliver={data.navDeliver}
		navProjects={data.navProjects}
		navAbout={data.navAbout}
		navContact={data.navContact}
		navProductsColumn={data.navProductsColumn}
		deliverMarkets={data.deliverMarkets}
		hero={data.hero}
		problemTitle={data.problemTitle}
		problemLead={data.problemLead}
		problemItems={data.problemItems}
		productsTitle={data.productsTitle}
		productsLead={data.productsLead}
		products={data.products}
		proof={data.proof}
		projectsTitle={data.projectsTitle}
		projectsLead={data.projectsLead}
		projects={data.projects}
		aboutTitle={data.aboutTitle}
		aboutLead={data.aboutLead}
		aboutBody={data.aboutBody}
		teamTitle={data.teamTitle}
		teamLead={data.teamLead}
		openTitle={data.openTitle}
		openLead={data.openLead}
		openItems={data.openItems}
		contactTitle={data.contactTitle}
		contactLead={data.contactLead}
		contactEmail={data.contactEmail}
		contactInterestLabel={data.contactInterestLabel}
		contactInterests={data.contactInterests}
		addressLines={data.addressLines}
		formLabels={formLabels}
	/>
</CompanyLayout>

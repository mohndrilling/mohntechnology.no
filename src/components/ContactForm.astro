---
interface Props {
	lang: 'en' | 'no';
	contactTitle: string;
	contactLead: string;
	formLabels: {
		name: string;
		email: string;
		message: string;
		submit: string;
		placeholderName: string;
		placeholderEmail: string;
		placeholderMessage: string;
	};
	contactPortalText?: string;
	contactPortalLink?: string;
	portalUrl?: string;
	interestLabel?: string;
	interestOptions?: string[];
}

const {
	lang,
	contactTitle,
	contactLead,
	formLabels,
	contactPortalText,
	contactPortalLink,
	portalUrl,
	interestLabel,
	interestOptions = [],
} = Astro.props;
const showPortal = Boolean(contactPortalText && contactPortalLink && portalUrl);
const showInterest = Boolean(interestLabel && interestOptions.length > 0);

const apiUrl = (import.meta.env.PUBLIC_CONTACT_API_URL as string | undefined)?.trim() ?? '';

const msgSending = lang === 'no' ? 'Sender …' : 'Sending…';
const msgOk = lang === 'no' ? 'Takk! Vi har mottatt meldingen din.' : 'Thanks! We have received your message.';
const msgErr =
	lang === 'no'
		? 'Kunne ikke sende meldingen. Prøv igjen senere, eller ta kontakt på e-post.'
		: 'Could not send the message. Please try again later or contact us by email.';
const msgNocfg =
	lang === 'no'
		? 'Kontaktskjemaet er ikke konfigurert (mangler PUBLIC_CONTACT_API_URL).'
		: 'The contact form is not configured (missing PUBLIC_CONTACT_API_URL).';
const msgBad =
	lang === 'no' ? 'Sjekk at alle felt er fylt ut riktig.' : 'Please check that all fields are valid.';
const interestPrefix = lang === 'no' ? 'Interesse' : 'Interest';
---

<section id="contact" class="section cta">
	<div class="container cta-inner">
		<h2 class="section-title">{contactTitle}</h2>
		<p class="section-lead">{contactLead}</p>
		<form class="contact-form" method="post" action="#" novalidate data-contact-api={apiUrl} data-interest-prefix={interestPrefix}>
			<div class="form-honeypot" aria-hidden="true">
				<label for={`company-${lang}`}>Company</label>
				<input type="text" id={`company-${lang}`} name="company" tabindex="-1" autocomplete="off" />
			</div>
			{showInterest && (
				<div class="form-row">
					<label for={`interest-${lang}`}>{interestLabel}</label>
					<select id={`interest-${lang}`} name="interest" required>
						<option value="" disabled selected>
							{lang === 'no' ? 'Velg…' : 'Select…'}
						</option>
						{interestOptions.map((option) => (
							<option value={option}>{option}</option>
						))}
					</select>
				</div>
			)}
			<div class="form-row">
				<label for={`name-${lang}`}>{formLabels.name}</label>
				<input id={`name-${lang}`} name="name" type="text" required placeholder={formLabels.placeholderName} />
			</div>
			<div class="form-row">
				<label for={`email-${lang}`}>{formLabels.email}</label>
				<input id={`email-${lang}`} name="email" type="email" required placeholder={formLabels.placeholderEmail} />
			</div>
			<div class="form-row">
				<label for={`message-${lang}`}>{formLabels.message}</label>
				<textarea id={`message-${lang}`} name="message" rows="4" placeholder={formLabels.placeholderMessage} required></textarea>
			</div>
			<p class="form-status" role="status" aria-live="polite" hidden></p>
			<button type="submit" class="btn btn-primary btn-lg contact-submit">{formLabels.submit}</button>
		</form>
		{showPortal && (
			<p class="cta-portal">
				{contactPortalText} <a href={portalUrl} target="_blank" rel="noopener">{contactPortalLink}</a>.
			</p>
		)}
	</div>
</section>

<style>
	.cta-inner {
		max-width: 38rem;
		width: 100%;
		margin-inline: auto;
	}
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 1.5rem;
	}
	.form-row {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.form-row label {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-text-muted);
	}
	.form-row input,
	.form-row textarea,
	.form-row select {
		padding: 0.75rem 1rem;
		font-family: var(--font-body);
		font-size: 1rem;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}
	.form-row input::placeholder,
	.form-row textarea::placeholder {
		color: var(--color-text-muted);
		opacity: 0.7;
	}
	.form-row input:focus,
	.form-row textarea:focus,
	.form-row select:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-dim);
	}
	.cta-portal {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		margin: 0;
	}
	.form-honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.form-status {
		margin: 0 0 1rem;
		font-size: 0.95rem;
		color: var(--color-text-muted);
	}
	.form-status[data-kind='ok'] {
		color: var(--color-accent);
	}
	.form-status[data-kind='err'] {
		color: #f87171;
	}
	[data-theme='light'] .form-status[data-kind='err'] {
		color: #b91c1c;
	}
</style>

<script define:vars={{ apiUrl, msgSending, msgOk, msgErr, msgNocfg, msgBad }}>
	function wireForm(form) {
		const url = form.dataset.contactApi?.trim() || '';
		const statusEl = form.querySelector('.form-status');
		const submitBtn = form.querySelector('.contact-submit');
		const interestPrefix = form.dataset.interestPrefix || 'Interest';

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!statusEl || !submitBtn) return;

			if (!url) {
				statusEl.hidden = false;
				statusEl.dataset.kind = 'err';
				statusEl.textContent = msgNocfg;
				return;
			}

			const fd = new FormData(form);
			const interest = String(fd.get('interest') || '').trim();
			const rawMessage = String(fd.get('message') || '').trim();
			const message = interest ? `[${interestPrefix}: ${interest}]\n\n${rawMessage}` : rawMessage;

			const payload = {
				name: String(fd.get('name') || '').trim(),
				email: String(fd.get('email') || '').trim(),
				message,
				company: String(fd.get('company') || '').trim(),
			};

			statusEl.hidden = false;
			statusEl.dataset.kind = '';
			statusEl.textContent = msgSending;
			submitBtn.disabled = true;

			try {
				const res = await fetch(url, {
					method: 'POST',
					headers: {
						Accept: 'application/json',
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(payload),
				});
				const data = await res.json().catch(() => ({}));

				if (res.ok && (data.ok === 'sent' || data.ok === 'logged')) {
					statusEl.dataset.kind = 'ok';
					statusEl.textContent = msgOk;
					form.reset();
				} else {
					statusEl.dataset.kind = 'err';
					statusEl.textContent = res.status === 400 ? msgBad : msgErr;
				}
			} catch {
				statusEl.dataset.kind = 'err';
				statusEl.textContent = msgErr;
			} finally {
				submitBtn.disabled = false;
			}
		});
	}

	document.querySelectorAll('form.contact-form[data-contact-api]').forEach((form) => {
		if (form instanceof HTMLFormElement) wireForm(form);
	});
</script>

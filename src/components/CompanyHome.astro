<script>
	function initShell(shell) {
		const mainTabs = [...shell.querySelectorAll('[data-main-tab]:not([data-mobile-tab])')];
		const mobileTabs = [...shell.querySelectorAll('[data-mobile-tab]')];
		const allMainTriggers = [...shell.querySelectorAll('[data-main-tab]')];
		const mainPanels = [...shell.querySelectorAll('[data-main-panel]')];
		const homeLanding = shell.querySelector('[data-home-landing]');
		const panelsRoot = shell.querySelector('.mt-panels');
		const menuToggle = shell.querySelector('[data-menu-toggle]');
		const mobileNav = shell.querySelector('[data-mobile-nav]');

		function setInterest(value) {
			if (!value) return;
			const select = shell.querySelector('select[name="interest"]');
			if (!(select instanceof HTMLSelectElement)) return;
			const match = [...select.options].find((opt) => opt.value === value);
			if (match) select.value = value;
		}

		function closeMobileNav() {
			if (!(mobileNav instanceof HTMLElement) || !(menuToggle instanceof HTMLButtonElement)) return;
			mobileNav.hidden = true;
			menuToggle.setAttribute('aria-expanded', 'false');
		}

		function activateMain(id, { focus = true, interest } = {}) {
			const onHome = id === 'home';
			allMainTriggers.forEach((tab) => {
				const active = !onHome && tab.getAttribute('data-main-tab') === id;
				tab.classList.toggle('is-active', active);
				if (tab.getAttribute('role') === 'tab') {
					tab.setAttribute('aria-selected', active ? 'true' : 'false');
					tab.tabIndex = active ? 0 : -1;
				}
			});
			mainPanels.forEach((panel) => {
				const active = !onHome && panel.getAttribute('data-main-panel') === id;
				panel.classList.toggle('is-active', active);
				panel.hidden = !active;
			});
			if (homeLanding instanceof HTMLElement) {
				homeLanding.hidden = !onHome;
			}
			if (panelsRoot instanceof HTMLElement) {
				panelsRoot.hidden = onHome;
			}
			if (interest) setInterest(interest);
			closeMobileNav();
			if (focus && !onHome) {
				const panel = mainPanels.find((p) => p.getAttribute('data-main-panel') === id);
				panel?.focus({ preventScroll: true });
			}
			const url = new URL(window.location.href);
			if (onHome) {
				url.hash = '';
			} else {
				url.hash = id;
			}
			history.replaceState(null, '', url);
		}

		mainTabs.forEach((tab) => {
			tab.addEventListener('click', () => activateMain(tab.getAttribute('data-main-tab') || 'deliver'));
		});
		mobileTabs.forEach((tab) => {
			tab.addEventListener('click', () => activateMain(tab.getAttribute('data-main-tab') || 'deliver'));
		});

		if (menuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
			menuToggle.addEventListener('click', () => {
				const open = mobileNav.hidden;
				mobileNav.hidden = !open;
				menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			});
		}

		shell.querySelectorAll('[data-switch-main]').forEach((el) => {
			el.addEventListener('click', (event) => {
				if (el instanceof HTMLAnchorElement && el.getAttribute('href')?.startsWith('http')) return;
				event.preventDefault();
				activateMain(el.getAttribute('data-switch-main') || 'home', {
					interest: el.getAttribute('data-interest') || undefined,
				});
			});
		});

		const hash = window.location.hash.replace(/^#/, '').toLowerCase();
		if (['deliver', 'products', 'work', 'about', 'platform', 'open', 'contact'].includes(hash)) {
			const mapped =
				hash === 'products' || hash === 'platform' || hash === 'open'
					? hash === 'products'
						? 'deliver'
						: 'about'
					: hash;
			activateMain(mapped, { focus: false });
		} else {
			activateMain('home', { focus: false });
		}
	}

	document.querySelectorAll('[data-mt-shell]').forEach((shell) => {
		if (shell instanceof HTMLElement) initShell(shell);
	});
</script>

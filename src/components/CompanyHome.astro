---
import ContactForm from './ContactForm.astro';
import LocaleThemeControls from './LocaleThemeControls.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import TeamGrid from './TeamGrid.astro';
import { productPath, productSlugFromName } from '../lib/productPaths';

type Media = {
	kind?: 'image' | 'video';
	src?: string;
	label: string;
	need: string;
	message: string;
};

type Product = {
	slug: string;
	title: string;
	blurb: string;
};

type DeliverMarket = {
	title: string;
	blurb: string;
	product: string;
	cta: string;
};

type Proof = { value: string; label: string };
type Project = {
	tag: string;
	title: string;
	place: string;
	problem: string;
	result: string;
	media: Media;
};
type ProblemItem = { title: string; body: string };
type OpenItem = { title: string; body: string; cta: string; href: string };

interface Props {
	lang: 'en' | 'no';
	homePath: string;
	navDeliver: string;
	navProjects: string;
	navAbout: string;
	navContact: string;
	navProductsColumn: string;
	deliverMarkets: DeliverMarket[];
	hero: {
		brand: string;
		title: string;
		lead: string;
		ctaPrimary: string;
		ctaSecondary: string;
		media: Media;
	};
	problemTitle: string;
	problemLead: string;
	problemItems: ProblemItem[];
	productsTitle: string;
	productsLead: string;
	products: Product[];
	proof: Proof[];
	projectsTitle: string;
	projectsLead: string;
	projects: Project[];
	aboutTitle: string;
	aboutLead: string;
	aboutBody: string;
	teamTitle: string;
	teamLead: string;
	openTitle: string;
	openLead: string;
	openItems: OpenItem[];
	contactTitle: string;
	contactLead: string;
	contactEmail: string;
	contactInterestLabel: string;
	contactInterests: string[];
	addressLines: string[];
	formLabels: {
		name: string;
		email: string;
		message: string;
		submit: string;
		placeholderName: string;
		placeholderEmail: string;
		placeholderMessage: string;
	};
}

const {
	lang,
	homePath,
	navDeliver,
	navProjects,
	navAbout,
	navContact,
	navProductsColumn,
	deliverMarkets,
	hero,
	problemTitle,
	problemLead,
	problemItems,
	productsTitle,
	productsLead,
	products,
	proof,
	projectsTitle,
	projectsLead,
	projects,
	aboutTitle,
	aboutLead,
	aboutBody,
	teamTitle,
	teamLead,
	openTitle,
	openLead,
	openItems,
	contactTitle,
	contactLead,
	contactEmail,
	contactInterestLabel,
	contactInterests,
	addressLines,
	formLabels,
} = Astro.props;

const uid = `mt-${lang}`;
const mainTabs = [
	{ id: 'deliver', label: navDeliver, mega: true },
	{ id: 'work', label: navProjects },
	{ id: 'about', label: navAbout },
	{ id: 'contact', label: navContact },
] as const;

const marketsLabel = lang === 'no' ? 'Markeder' : 'Markets';
const problemLabel = lang === 'no' ? 'Behov' : 'Need';
const resultLabel = lang === 'no' ? 'Leveranse' : 'Delivered';
const mainTabsLabel = lang === 'no' ? 'Hovedmeny' : 'Main navigation';
const menuLabel = lang === 'no' ? 'Meny' : 'Menu';
const overviewLabel = lang === 'no' ? 'Oversikt' : 'Overview';
const linkToEn = '/';
const linkToNo = '/no/';

const marketsWithHref = deliverMarkets.map((market) => ({
	...market,
	href: productPath(lang, productSlugFromName(market.product)),
}));
const productsWithHref = products.map((product) => ({
	...product,
	href: productPath(lang, product.slug),
}));

const interestForOpen = openItems.map((_, i) => {
	const careers = lang === 'no' ? 'Jobb / samarbeid' : 'Careers / work with us';
	const vision = lang === 'no' ? 'Skreddersydd maskinsynløsning' : 'Custom vision problem';
	return i === 0 ? careers : vision;
});
---

<div class="mt-shell" data-mt-shell data-uid={uid}>
	<header class="mt-header" data-header>
		<div class="container mt-header-inner">
			<a href={homePath} class="mt-logo" data-switch-main="deliver" aria-label={hero.brand}>
				<img
					src="/media/company/brand/mohn-technology-logo.png"
					alt={hero.brand}
					width="180"
					height="125"
					decoding="async"
				/>
			</a>

			<nav class="mt-nav" aria-label={mainTabsLabel}>
				<div class="mt-tablist" role="tablist" aria-label={mainTabsLabel}>
					{
						mainTabs.map((tab, i) =>
							tab.mega ? (
								<div class="mt-mega-wrap" data-mega-wrap>
									<button
										type="button"
										class:list={['mt-nav-link', 'mt-mega-trigger', { 'is-active': i === 0 }]}
										role="tab"
										id={`${uid}-main-tab-${tab.id}`}
										aria-selected={i === 0 ? 'true' : 'false'}
										aria-controls={`${uid}-main-panel-${tab.id}`}
										aria-expanded="false"
										aria-haspopup="true"
										tabindex={i === 0 ? 0 : -1}
										data-main-tab={tab.id}
										data-mega-trigger
									>
										{tab.label}
										<span class="mt-mega-chevron" aria-hidden="true" />
									</button>
									<div
										class="mt-mega"
										id={`${uid}-mega`}
										data-mega
										hidden
										role="region"
										aria-label={navDeliver}
									>
										<div class="mt-mega-inner">
											<div class="mt-mega-col">
												<p class="mt-mega-heading">{marketsLabel}</p>
												<ul class="mt-mega-list">
													{marketsWithHref.map((market) => (
														<li>
															<a class="mt-mega-item" href={market.href}>
																<span class="mt-mega-item-title">{market.title}</span>
																<span class="mt-mega-item-blurb">{market.blurb}</span>
															</a>
														</li>
													))}
												</ul>
											</div>
											<div class="mt-mega-col mt-mega-col-products">
												<p class="mt-mega-heading">{navProductsColumn}</p>
												<ul class="mt-mega-list">
													{productsWithHref.map((product) => (
														<li>
															<a class="mt-mega-item mt-mega-item-product" href={product.href}>
																<span class="mt-mega-item-title">{product.title}</span>
															</a>
														</li>
													))}
												</ul>
												<button type="button" class="mt-mega-overview" data-switch-main="deliver">
													{overviewLabel}
												</button>
											</div>
										</div>
									</div>
								</div>
							) : (
								<button
									type="button"
									class:list={['mt-nav-link', { 'is-active': i === 0 }]}
									role="tab"
									id={`${uid}-main-tab-${tab.id}`}
									aria-selected={i === 0 ? 'true' : 'false'}
									aria-controls={`${uid}-main-panel-${tab.id}`}
									tabindex={i === 0 ? 0 : -1}
									data-main-tab={tab.id}
								>
									{tab.label}
								</button>
							),
						)
					}
				</div>
			</nav>

			<div class="mt-header-tools">
				<LocaleThemeControls locale={lang} linkToEn={linkToEn} linkToNo={linkToNo} />
				<button type="button" class="mt-menu-toggle" data-menu-toggle aria-expanded="false" aria-controls={`${uid}-mobile-nav`}>
					{menuLabel}
				</button>
			</div>
		</div>

		<div class="mt-mobile-nav container" id={`${uid}-mobile-nav`} data-mobile-nav hidden>
			<button
				type="button"
				class="mt-mobile-link is-active"
				data-main-tab="deliver"
				data-mobile-tab
			>
				{navDeliver}
			</button>
			<p class="mt-mobile-group">{marketsLabel}</p>
			{
				marketsWithHref.map((market) => (
					<a class="mt-mobile-link mt-mobile-sub" href={market.href}>
						{market.title}
					</a>
				))
			}
			<p class="mt-mobile-group">{navProductsColumn}</p>
			{
				productsWithHref.map((product) => (
					<a class="mt-mobile-link mt-mobile-sub" href={product.href}>
						{product.title}
					</a>
				))
			}
			{
				mainTabs
					.filter((tab) => tab.id !== 'deliver')
					.map((tab) => (
						<button type="button" class="mt-mobile-link" data-main-tab={tab.id} data-mobile-tab>
							{tab.label}
						</button>
					))
			}
		</div>
	</header>

	<main>
		<section class="mt-intro container" aria-label={lang === 'no' ? 'Introduksjon' : 'Introduction'} data-intro>
			<div class="mt-intro-media">
				<MediaPlaceholder
					label={hero.media.label}
					need={hero.media.need}
					message={hero.media.message}
					src={hero.media.src}
					kind={hero.media.kind}
					aspect="hero"
				/>
			</div>
		</section>

		<div class="mt-panels container">
			<section
				class="mt-panel is-active"
				role="tabpanel"
				id={`${uid}-main-panel-deliver`}
				aria-labelledby={`${uid}-main-tab-deliver`}
				data-main-panel="deliver"
				tabindex="0"
			>
				<h2 class="section-title problem-headline">{problemTitle}</h2>
				<p class="section-lead">{problemLead}</p>
				<div class="problem-grid">
					{problemItems.map((item) => (
						<article class="problem-item">
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</article>
					))}
				</div>

				<div class="markets-block">
					<h3 class="markets-heading">{marketsLabel}</h3>
					<p class="section-lead markets-lead">
						{lang === 'no'
							? 'Start med operasjonen du kjører — så produktlinjen som passer.'
							: 'Start with the operation you run — then the product line that fits.'}
					</p>
					<div class="markets-grid">
						{marketsWithHref.map((market) => (
							<a class="market-card" href={market.href}>
								<span class="market-card-title">{market.title}</span>
								<span class="market-card-blurb">{market.blurb}</span>
								<span class="market-card-cta">
									{market.cta}
									<span aria-hidden="true"> →</span>
								</span>
							</a>
						))}
					</div>
				</div>

				<div class="products-block" id={`${uid}-products`}>
					<h3 class="products-heading">{productsTitle}</h3>
					<p class="section-lead products-lead">{productsLead}</p>
					<div class="product-link-grid">
						{productsWithHref.map((product) => (
							<a class="product-link-card" href={product.href}>
								<span class="product-link-title">{product.title}</span>
								<span class="product-link-blurb">{product.blurb}</span>
								<span class="product-link-cta">
									{lang === 'no' ? 'Åpne produktside' : 'Open product page'}
									<span aria-hidden="true"> →</span>
								</span>
							</a>
						))}
					</div>
				</div>
			</section>

			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-work`}
				aria-labelledby={`${uid}-main-tab-work`}
				data-main-panel="work"
				hidden
				tabindex="0"
			>
				<h2 class="section-title">{projectsTitle}</h2>
				<p class="section-lead">{projectsLead}</p>
				<div class="story-list">
					{projects.map((project) => (
						<article class="story-card">
							<div class="story-card-media">
								<MediaPlaceholder
									label={project.media.label}
									need={project.media.need}
									message={project.media.message}
									src={project.media.src}
									kind={project.media.kind}
									aspect="story"
								/>
							</div>
							<div class="story-card-body">
								<p class="story-eyebrow">{project.place}</p>
								<p class="story-tag">{project.tag}</p>
								<h3>{project.title}</h3>
								<p>
									<strong>{problemLabel}:</strong> {project.problem}
								</p>
								<p>
									<strong>{resultLabel}:</strong> {project.result}
								</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-about`}
				aria-labelledby={`${uid}-main-tab-about`}
				data-main-panel="about"
				hidden
				tabindex="0"
			>
				<h2 class="section-title">{aboutTitle}</h2>
				<p class="section-lead">{aboutLead}</p>
				<p class="about-body">{aboutBody}</p>
				<div class="proof-strip">
					{proof.map((item) => (
						<div class="proof-item">
							<p class="proof-value">{item.value}</p>
							<p class="proof-label">{item.label}</p>
						</div>
					))}
				</div>

				<TeamGrid lang={lang} title={teamTitle} lead={teamLead} />

				<div class="open-block">
					<h3 class="open-heading">{openTitle}</h3>
					<p class="section-lead">{openLead}</p>
					<div class="open-grid">
						{openItems.map((item, i) => (
							<article class="open-item">
								<h4>{item.title}</h4>
								<p>{item.body}</p>
								<button type="button" class="btn btn-ghost" data-switch-main="contact" data-interest={interestForOpen[i]}>
									{item.cta}
								</button>
							</article>
						))}
					</div>
				</div>
			</section>

			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-contact`}
				aria-labelledby={`${uid}-main-tab-contact`}
				data-main-panel="contact"
				hidden
				tabindex="0"
			>
				<div class="contact-layout">
					<div class="contact-main">
						<ContactForm
							lang={lang}
							contactTitle={contactTitle}
							contactLead={contactLead}
							formLabels={formLabels}
							interestLabel={contactInterestLabel}
							interestOptions={contactInterests}
						/>
					</div>
					<aside class="contact-aside">
						<p class="address-email">
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
						</p>
						<address class="address-block">
							{addressLines.map((line) => (
								<span>{line}</span>
							))}
						</address>
					</aside>
				</div>
			</section>
		</div>
	</main>
</div>

<style>
	.mt-shell {
		min-height: 70vh;
	}

	.mt-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--header-bg);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-border);
	}
	.mt-header-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem 1.5rem;
		min-height: 4rem;
	}
	.mt-logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		line-height: 0;
	}
	.mt-logo img {
		display: block;
		height: clamp(2.35rem, 4.2vw, 2.85rem);
		width: auto;
	}
	.mt-logo:hover {
		opacity: 0.88;
		text-decoration: none;
	}
	:global([data-theme='light']) .mt-logo img {
		filter: invert(1);
	}

	.mt-nav {
		display: none;
		justify-content: center;
	}
	@media (min-width: 960px) {
		.mt-nav {
			display: flex;
		}
		.mt-menu-toggle {
			display: none;
		}
	}
	.mt-tablist {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.mt-nav-link {
		appearance: none;
		border: none;
		background: transparent;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 500;
		padding: 0.55rem 0.75rem;
		border-radius: 0;
		cursor: pointer;
		position: relative;
	}
	.mt-nav-link:hover {
		color: var(--color-text);
	}
	.mt-nav-link.is-active {
		color: var(--color-text);
		font-weight: 600;
	}
	.mt-nav-link.is-active::after {
		content: '';
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.2rem;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
	}

	.mt-mega-wrap {
		position: relative;
	}
	.mt-mega-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.mt-mega-chevron {
		width: 0.45rem;
		height: 0.45rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		opacity: 0.7;
		transition: transform 0.15s ease;
	}
	.mt-mega-trigger[aria-expanded='true'] .mt-mega-chevron {
		transform: rotate(225deg) translateY(-1px);
	}
	.mt-mega {
		position: absolute;
		top: calc(100% + 0.55rem);
		left: 50%;
		transform: translateX(-40%);
		width: min(42rem, calc(100vw - 2rem));
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: 0 18px 40px color-mix(in srgb, var(--color-text) 12%, transparent);
		padding: 1.15rem 1.25rem 1.25rem;
		z-index: 120;
	}
	.mt-mega[hidden] {
		display: none;
	}
	.mt-mega-inner {
		display: grid;
		grid-template-columns: 1.4fr 0.9fr;
		gap: 1.5rem;
	}
	.mt-mega-heading {
		margin: 0 0 0.65rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.mt-mega-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	.mt-mega-item {
		appearance: none;
		width: 100%;
		border: none;
		background: transparent;
		text-align: left;
		padding: 0.55rem 0.6rem;
		cursor: pointer;
		font-family: var(--font-body);
		color: var(--color-text);
		border-radius: var(--radius);
		text-decoration: none;
		display: block;
	}
	.mt-mega-item:hover {
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
		text-decoration: none;
		color: var(--color-text);
	}
	.mt-mega-item-title {
		display: block;
		font-weight: 650;
		font-size: 0.95rem;
	}
	.mt-mega-item-blurb {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--color-text-muted);
	}
	.mt-mega-item-product .mt-mega-item-title {
		font-size: 1rem;
	}
	.mt-mega-overview {
		appearance: none;
		border: none;
		background: none;
		margin-top: 0.85rem;
		padding: 0;
		font-family: var(--font-body);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-accent);
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.mt-header-tools {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		justify-self: end;
	}
	.mt-menu-toggle {
		appearance: none;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.45rem 0.75rem;
		border-radius: var(--radius);
		cursor: pointer;
	}
	.mt-mobile-nav {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		padding: 0.35rem 0 0.85rem;
		border-top: 1px solid var(--color-border);
	}
	.mt-mobile-nav[hidden] {
		display: none;
	}
	.mt-mobile-group {
		margin: 0.7rem 0 0.15rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.mt-mobile-link {
		appearance: none;
		border: none;
		background: transparent;
		text-align: left;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 500;
		padding: 0.7rem 0.15rem;
		cursor: pointer;
		border-bottom: 1px solid var(--color-border);
	}
	.mt-mobile-sub {
		font-size: 0.95rem;
		padding-left: 0.75rem;
	}
	.mt-mobile-link.is-active {
		color: var(--color-accent);
		font-weight: 600;
	}

	.mt-intro {
		padding: 1.5rem 0 0.25rem;
		max-width: 52rem;
	}
	.mt-intro-media {
		margin-bottom: 0;
	}
	.mt-intro.is-collapsed {
		display: none;
	}

	.mt-panels {
		padding: 1.75rem 0 3.5rem;
	}
	.mt-panel[hidden] {
		display: none;
	}
	.mt-panel:focus {
		outline: none;
	}

	.problem-headline {
		max-width: 28ch;
	}
	.problem-grid {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}
	@media (min-width: 800px) {
		.problem-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.problem-item {
		border-top: 2px solid var(--color-accent);
		padding-top: 0.9rem;
	}
	.problem-item h3 {

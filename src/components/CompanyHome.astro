---
import ContactForm from './ContactForm.astro';
import LocaleThemeControls from './LocaleThemeControls.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import TeamGrid from './TeamGrid.astro';
import { productPath, productSlugFromName } from '../lib/productPaths';

type Media = {
	kind?: 'image' | 'video';
	src?: string;
	label: string;
	need: string;
	message: string;
};

type Product = {
	slug: string;
	title: string;
	blurb: string;
};

type DeliverMarket = {
	title: string;
	blurb: string;
	product: string;
	cta: string;
	image?: string;
	imageAlt?: string;
	video?: string;
};

type Proof = { value: string; label: string };
type Project = {
	tag: string;
	title: string;
	place: string;
	problem: string;
	result: string;
	media: Media;
};
type ProblemItem = { title: string; body: string };
type OpenItem = { title: string; body: string; cta: string; href: string };

interface Props {
	lang: 'en' | 'no';
	homePath: string;
	navDeliver: string;
	navProjects: string;
	navAbout: string;
	navContact: string;
	navProductsColumn: string;
	deliverMarkets: DeliverMarket[];
	hero: {
		brand: string;
		title: string;
		lead: string;
		ctaPrimary: string;
		ctaSecondary: string;
		media: Media;
	};
	problemTitle: string;
	problemLead: string;
	problemItems: ProblemItem[];
	productsTitle: string;
	productsLead: string;
	products: Product[];
	proof: Proof[];
	projectsTitle: string;
	projectsLead: string;
	projects: Project[];
	aboutTitle: string;
	aboutLead: string;
	aboutBody: string;
	teamTitle: string;
	teamLead: string;
	openTitle: string;
	openLead: string;
	openItems: OpenItem[];
	contactTitle: string;
	contactLead: string;
	contactEmail: string;
	contactInterestLabel: string;
	contactInterests: string[];
	addressLines: string[];
	formLabels: {
		name: string;
		email: string;
		message: string;
		submit: string;
		placeholderName: string;
		placeholderEmail: string;
		placeholderMessage: string;
	};
}

const {
	lang,
	homePath,
	navDeliver,
	navProjects,
	navAbout,
	navContact,
	navProductsColumn,
	deliverMarkets,
	hero,
	problemTitle,
	problemLead,
	problemItems,
	productsTitle,
	productsLead,
	products,
	projectsTitle,
	projectsLead,
	projects,
	aboutTitle,
	aboutLead,
	aboutBody,
	teamTitle,
	teamLead,
	openTitle,
	openLead,
	openItems,
	contactTitle,
	contactLead,
	contactEmail,
	contactInterestLabel,
	contactInterests,
	addressLines,
	formLabels,
} = Astro.props;

const uid = `mt-${lang}`;
const mainTabs = [
	{ id: 'deliver', label: navDeliver },
	{ id: 'work', label: navProjects },
	{ id: 'about', label: navAbout },
	{ id: 'contact', label: navContact },
] as const;

const marketsLabel = lang === 'no' ? 'Markeder' : 'Markets';
const problemLabel = lang === 'no' ? 'Behov' : 'Need';
const resultLabel = lang === 'no' ? 'Leveranse' : 'Delivered';
const mainTabsLabel = lang === 'no' ? 'Hovedmeny' : 'Main navigation';
const menuLabel = lang === 'no' ? 'Meny' : 'Menu';
const linkToEn = '/';
const linkToNo = '/no/';

const marketsWithHref = deliverMarkets.map((market) => ({
	...market,
	href: productPath(lang, productSlugFromName(market.product)),
}));
const productsWithHref = products.map((product) => ({
	...product,
	href: productPath(lang, product.slug),
}));

const careersInterest = lang === 'no' ? 'Jobb / samarbeid' : 'Careers / work with us';
const visionInterest = lang === 'no' ? 'Skreddersydd maskinsynløsning' : 'Custom vision problem';
const openItemsWithInterest = openItems.map((item, index) => ({
	...item,
	interest: index === 0 ? careersInterest : visionInterest,
}));
---

<div class="mt-shell" data-mt-shell data-uid={uid}>
	<header class="mt-header" data-header>
		<div class="container mt-header-inner">
			<a href={homePath} class="mt-logo" data-switch-main="home" aria-label={hero.brand}>
				<img
					src="/media/company/brand/mohn-technology-logo.png"
					alt={hero.brand}
					width="963"
					height="670"
					decoding="async"
					fetchpriority="high"
				/>
			</a>

			<nav class="mt-nav" aria-label={mainTabsLabel}>
				<div class="mt-tablist" role="tablist" aria-label={mainTabsLabel}>
					<button
						type="button"
						class="mt-nav-link"
						data-switch-main="home"
					>
						{lang === 'no' ? 'Hjem' : 'Home'}
					</button>
					{
						mainTabs.map((tab) => (
							<button
								type="button"
								class="mt-nav-link"
								role="tab"
								id={`${uid}-main-tab-${tab.id}`}
								aria-selected="false"
								aria-controls={`${uid}-main-panel-${tab.id}`}
								tabindex={-1}
								data-main-tab={tab.id}
							>
								{tab.label}
							</button>
						))
					}
				</div>
			</nav>

			<div class="mt-header-tools">
				<LocaleThemeControls locale={lang} linkToEn={linkToEn} linkToNo={linkToNo} showTheme={false} />
				<button type="button" class="mt-menu-toggle" data-menu-toggle aria-expanded="false" aria-controls={`${uid}-mobile-nav`}>
					{menuLabel}
				</button>
			</div>
		</div>

		<div class="mt-mobile-nav container" id={`${uid}-mobile-nav`} data-mobile-nav hidden>
			<button type="button" class="mt-mobile-link" data-switch-main="home">
				{lang === 'no' ? 'Hjem' : 'Home'}
			</button>
			<button type="button" class="mt-mobile-link" data-main-tab="deliver" data-mobile-tab>
				{navDeliver}
			</button>
			<p class="mt-mobile-group">{marketsLabel}</p>
			{
				marketsWithHref.map((market) => (
					<a class="mt-mobile-link mt-mobile-sub" href={market.href}>
						{market.title}
					</a>
				))
			}
			<p class="mt-mobile-group">{navProductsColumn}</p>
			{
				productsWithHref.map((product) => (
					<a class="mt-mobile-link mt-mobile-sub" href={product.href}>
						{product.title}
					</a>
				))
			}
			{
				mainTabs
					.filter((tab) => tab.id !== 'deliver')
					.map((tab) => (
						<button type="button" class="mt-mobile-link" data-main-tab={tab.id} data-mobile-tab>
							{tab.label}
						</button>
					))
			}
		</div>
	</header>

	<main>
		<section
			class="mt-home"
			aria-label={lang === 'no' ? 'Hjem' : 'Home'}
			data-home-landing
		>
			<div class="mt-home-visual">
				<MediaPlaceholder
					label={hero.media.label}
					need={hero.media.need}
					message={hero.media.message}
					src={hero.media.src}
					kind={hero.media.kind}
					aspect="hero"
					bleed
					ambient
				/>
				<div class="mt-home-veil" aria-hidden="true" />
				<div class="mt-home-copy">
					<p class="mt-home-brand">{hero.brand}</p>
					<h1 class="mt-home-title">{hero.title}</h1>
					<p class="mt-home-lead">{hero.lead}</p>
					<button type="button" class="btn btn-primary mt-home-cta" data-switch-main="deliver">
						{hero.ctaPrimary}
					</button>
				</div>
			</div>
		</section>

		<div class="mt-panels container" hidden>
			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-deliver`}
				aria-labelledby={`${uid}-main-tab-deliver`}
				data-main-panel="deliver"
				hidden
				tabindex="0"
			>
				<h2 class="section-title">{navDeliver}</h2>
				<p class="section-lead markets-lead">
					{lang === 'no'
						? 'Vi leverer skreddersydde maskinsynsystemer for automatisk vurdering av fiskehelse som tåler marine miljø. Vi utvikler og bygger alle våre produkter i Norge.'
						: 'We deliver tailored machine vision systems for automatic fish-health assessment, built for marine environments. We develop and build all our products in Norway.'}
				</p>
				<div class="markets-grid">
					{marketsWithHref.map((market) => (
						<a class="market-card" href={market.href}>
							<span class="market-card-product">{market.product}</span>
							<span class="market-card-sector">{market.title}</span>
							<span class="market-card-blurb">{market.blurb}</span>
							<span class="market-card-cta">
								{lang === 'no' ? 'Les mer' : 'Learn more'}
								<span aria-hidden="true"> →</span>
							</span>
							{(market.video || market.image) && (
								<span class="market-card-media">
									{market.video ? (
										<video
											src={market.video}
											poster={market.image}
											autoplay
											muted
											loop
											playsinline
											preload="metadata"
											aria-label={market.imageAlt || market.product}
										/>
									) : (
										<img
											src={market.image}
											alt={market.imageAlt || market.product}
											width="640"
											height="400"
											loading="lazy"
											decoding="async"
										/>
									)}
								</span>
							)}
						</a>
					))}
				</div>
			</section>

			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-work`}
				aria-labelledby={`${uid}-main-tab-work`}
				data-main-panel="work"
				hidden
				tabindex="0"
			>
				<h2 class="section-title">{projectsTitle}</h2>
				<p class="section-lead">{projectsLead}</p>
				<div class="story-list">
					{projects.map((project) => (
						<article class="story-card">
							<div class="story-card-media">
								<MediaPlaceholder
									label={project.media.label}
									need={project.media.need}
									message={project.media.message}
									src={project.media.src}
									kind={project.media.kind}
									aspect="story"
								/>
							</div>
							<div class="story-card-body">
								<p class="story-eyebrow">{project.place}</p>
								<p class="story-tag">{project.tag}</p>
								<h3>{project.title}</h3>
								<p>
									<strong>{problemLabel}:</strong> {project.problem}
								</p>
								<p>
									<strong>{resultLabel}:</strong> {project.result}
								</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-about`}
				aria-labelledby={`${uid}-main-tab-about`}
				data-main-panel="about"
				hidden
				tabindex="0"
			>
				<h2 class="section-title">{aboutTitle}</h2>
				<p class="section-lead">{aboutLead}</p>
				<p class="about-body">{aboutBody}</p>

				<TeamGrid lang={lang} title={teamTitle} lead={teamLead} />

				<div class="open-block">
					<h3 class="open-heading">{openTitle}</h3>
					<p class="section-lead">{openLead}</p>
					<div class="open-grid">
						{openItemsWithInterest.map((item) => (
							<article class="open-item">
								<h4>{item.title}</h4>
								<p>{item.body}</p>
								<button type="button" class="btn btn-ghost" data-switch-main="contact" data-interest={item.interest}>
									{item.cta}
								</button>
							</article>
						))}
					</div>
				</div>
			</section>

			<section
				class="mt-panel"
				role="tabpanel"
				id={`${uid}-main-panel-contact`}
				aria-labelledby={`${uid}-main-tab-contact`}
				data-main-panel="contact"
				hidden
				tabindex="0"
			>
				<div class="contact-layout">
					<div class="contact-main">
						<ContactForm
							lang={lang}
							contactTitle={contactTitle}
							contactLead={contactLead}
							formLabels={formLabels}
							interestLabel={contactInterestLabel}
							interestOptions={contactInterests}
						/>
					</div>
					<aside class="contact-aside">
						<p class="address-email">
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
						</p>
						<address class="address-block">
							{addressLines.map((line) => (
								<span>{line}</span>
							))}
						</address>
					</aside>
				</div>
			</section>
		</div>
	</main>
</div>

<style>
	.mt-shell {
		min-height: 70vh;
	}

	.mt-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--header-bg);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-border);
	}
	.mt-header-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem 1.5rem;
		min-height: 4rem;
	}
	.mt-logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		line-height: 0;
	}
	.mt-logo img {
		display: block;
		height: clamp(3.1rem, 5.5vw, 3.75rem);
		width: auto;
		image-rendering: -webkit-optimize-contrast;
	}
	.mt-logo:hover {
		opacity: 0.88;
		text-decoration: none;
	}
	:global([data-theme='light']) .mt-logo img {
		filter: invert(1);
	}

	.mt-nav {
		display: none;
		justify-content: center;
	}
	@media (min-width: 960px) {
		.mt-nav {
			display: flex;
		}
		.mt-menu-toggle {
			display: none;
		}
	}
	.mt-tablist {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.mt-nav-link {
		appearance: none;
		border: none;
		background: transparent;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 500;
		padding: 0.55rem 0.75rem;
		border-radius: 0;
		cursor: pointer;
		position: relative;
	}
	.mt-nav-link:hover {
		color: var(--color-text);
	}
	.mt-nav-link.is-active {
		color: var(--color-text);
		font-weight: 600;
	}
	.mt-nav-link::after {
		content: '';
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.2rem;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
		transform: scaleX(0);
		transition: transform 0.25s ease;
	}
	.mt-nav-link.is-active::after {
		transform: scaleX(1);
	}

	.mt-header-tools {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		justify-self: end;
	}
	.mt-menu-toggle {
		appearance: none;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.45rem 0.75rem;
		border-radius: var(--radius);
		cursor: pointer;
	}
	.mt-mobile-nav {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		padding: 0.35rem 0 0.85rem;
		border-top: 1px solid var(--color-border);
	}
	.mt-mobile-nav[hidden] {
		display: none;
	}
	.mt-mobile-group {
		margin: 0.7rem 0 0.15rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.mt-mobile-link {
		appearance: none;
		border: none;
		background: transparent;
		text-align: left;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 500;
		padding: 0.7rem 0.15rem;
		cursor: pointer;
		border-bottom: 1px solid var(--color-border);
	}
	.mt-mobile-sub {
		font-size: 0.95rem;
		padding-left: 0.75rem;
	}
	.mt-mobile-link.is-active {
		color: var(--color-accent);
		font-weight: 600;
	}

	.mt-home {
		padding: 0;
	}
	.mt-home[hidden] {
		display: none;
	}
	.mt-home-visual {
		position: relative;
		margin: 0;
		overflow: hidden;
		min-height: max(28rem, calc(100svh - var(--header-h, 4.5rem)));
		height: max(28rem, calc(100svh - var(--header-h, 4.5rem)));
	}
	.mt-home-visual :global(.media-ph--bleed.media-ph--hero) {
		position: absolute;
		inset: 0;
		height: 100%;
		min-height: 100%;
	}
	.mt-home-veil {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(7, 16, 24, 0.2) 0%,
			rgba(7, 16, 24, 0.35) 40%,
			rgba(7, 16, 24, 0.82) 78%,
			rgba(7, 16, 24, 0.94) 100%
		);
	}
	.mt-home-copy {
		position: absolute;
		left: 0;
		right: 0;
		bottom: clamp(2.5rem, 10vh, 5.5rem);
		z-index: 2;
		width: var(--container);
		max-width: 100%;
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, 3rem);
		animation: mt-home-in 0.7s ease both;
	}
	.mt-home-brand {
		margin: 0 0 0.55rem;
		font-family: var(--font-heading);
		font-size: clamp(1.2rem, 2.6vw, 1.55rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--color-text);
	}
	.mt-home-title {
		font-family: var(--font-heading);
		font-weight: 650;
		font-size: clamp(1.75rem, 4.2vw, 2.85rem);
		line-height: 1.14;
		letter-spacing: -0.03em;
		margin: 0 0 0.75rem;
	}
	.mt-home-lead {
		margin: 0 0 1.35rem;
		color: color-mix(in srgb, var(--color-text) 78%, var(--color-text-muted));
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.55;
		max-width: min(38rem, 92%);
	}
	.mt-home-cta {
		margin-bottom: 0;
	}
	@keyframes mt-home-in {
		from {
			opacity: 0;
			transform: translateY(0.6rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.mt-panels {
		padding: 1.75rem 0 3.5rem;
		animation: mt-home-in 0.45s ease both;
	}
	.mt-panel[hidden] {
		display: none;
	}
	.mt-panel:focus {
		outline: none;
	}

	.problem-headline {
		max-width: 28ch;
	}
	.problem-grid {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}
	@media (min-width: 800px) {
		.problem-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.problem-item {
		border-top: 2px solid var(--color-accent);
		padding-top: 0.9rem;
	}
	.problem-item h3 {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		margin: 0 0 0.4rem;
	}
	.problem-item p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.95rem;
	}

	.markets-block {
		margin-bottom: 2.5rem;
	}
	.markets-heading,
	.products-heading,
	.open-heading {
		font-family: var(--font-heading);
		font-size: clamp(1.3rem, 2.4vw, 1.65rem);
		margin: 0 0 0.35rem;
	}
	.markets-lead,
	.products-lead {
		margin-bottom: 1.25rem;
	}
	.markets-grid {
		display: grid;
		gap: 0.85rem;
	}
	@media (min-width: 800px) {
		.markets-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.market-card {
		appearance: none;
		border: none;
		border-top: 2px solid var(--color-accent);
		background: transparent;
		text-align: left;
		padding: 0.95rem 0 0.35rem;
		font-family: var(--font-body);
		color: var(--color-text);
		display: grid;
		gap: 0.45rem;
		transition: transform 0.18s ease;
		text-decoration: none;
	}
	.market-card:hover {
		transform: translateY(-2px);
		text-decoration: none;
		color: var(--color-text);
	}
	.market-card-product {
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 2.2vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	.market-card-sector {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.market-card-blurb {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.market-card-cta {
		color: var(--color-accent);
		font-weight: 600;
		font-size: 0.92rem;
	}
	.market-card-media {
		display: block;
		margin-top: 0.35rem;
		overflow: hidden;
		border-radius: var(--radius);
		aspect-ratio: 16 / 10;
		background: var(--color-surface);
	}
	.market-card-media img,
	.market-card-media video {
		width: 100%;
		height: 100%;

<script>
	function initShell(shell) {
		const mainTabs = [...shell.querySelectorAll('[data-main-tab]:not([data-mobile-tab])')];
		const mobileTabs = [...shell.querySelectorAll('[data-mobile-tab]')];
		const allMainTriggers = [...shell.querySelectorAll('[data-main-tab]')];
		const mainPanels = [...shell.querySelectorAll('[data-main-panel]')];
		const productRoot = shell.querySelector('[data-product-tabs]');
		const productTabs = productRoot ? [...productRoot.querySelectorAll('[data-product-tab]')] : [];
		const productPanels = productRoot ? [...productRoot.querySelectorAll('[data-product-panel]')] : [];
		const intro = shell.querySelector('[data-intro]');
		const menuToggle = shell.querySelector('[data-menu-toggle]');
		const mobileNav = shell.querySelector('[data-mobile-nav]');

		function setInterest(value) {
			if (!value) return;
			const select = shell.querySelector('select[name="interest"]');
			if (!(select instanceof HTMLSelectElement)) return;
			const match = [...select.options].find((opt) => opt.value === value);
			if (match) select.value = value;
		}

		function closeMobileNav() {
			if (!(mobileNav instanceof HTMLElement) || !(menuToggle instanceof HTMLButtonElement)) return;
			mobileNav.hidden = true;
			menuToggle.setAttribute('aria-expanded', 'false');
		}

		function activateMain(id, { focus = true, interest } = {}) {
			allMainTriggers.forEach((tab) => {
				const active = tab.getAttribute('data-main-tab') === id;
				tab.classList.toggle('is-active', active);
				if (tab.getAttribute('role') === 'tab') {
					tab.setAttribute('aria-selected', active ? 'true' : 'false');
					tab.tabIndex = active ? 0 : -1;
				}
			});
			mainPanels.forEach((panel) => {
				const active = panel.getAttribute('data-main-panel') === id;
				panel.classList.toggle('is-active', active);
				panel.hidden = !active;
			});
			if (intro instanceof HTMLElement) {
				intro.classList.toggle('is-collapsed', id !== 'products');
			}
			if (interest) setInterest(interest);
			closeMobileNav();
			if (focus) {
				const panel = mainPanels.find((p) => p.getAttribute('data-main-panel') === id);
				panel?.focus({ preventScroll: true });
			}
			const url = new URL(window.location.href);
			url.hash = id;
			history.replaceState(null, '', url);
		}

		function activateProduct(index, { focus = true } = {}) {
			productTabs.forEach((tab) => {
				const active = Number(tab.getAttribute('data-product-tab')) === index;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', active ? 'true' : 'false');
				tab.tabIndex = active ? 0 : -1;
			});
			productPanels.forEach((panel) => {
				const active = Number(panel.getAttribute('data-product-panel')) === index;
				panel.classList.toggle('is-active', active);
				panel.hidden = !active;
			});
			if (focus) productPanels[index]?.focus({ preventScroll: true });
		}

		mainTabs.forEach((tab) => {
			tab.addEventListener('click', () => activateMain(tab.getAttribute('data-main-tab') || 'products'));
		});
		mobileTabs.forEach((tab) => {
			tab.addEventListener('click', () => activateMain(tab.getAttribute('data-main-tab') || 'products'));
		});
		productTabs.forEach((tab) => {
			tab.addEventListener('click', () => activateProduct(Number(tab.getAttribute('data-product-tab') || 0)));
		});

		if (menuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
			menuToggle.addEventListener('click', () => {
				const open = mobileNav.hidden;
				mobileNav.hidden = !open;
				menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			});
		}

		shell.querySelectorAll('[data-switch-main]').forEach((el) => {
			el.addEventListener('click', (event) => {
				if (el instanceof HTMLAnchorElement && el.getAttribute('href')?.startsWith('http')) return;
				event.preventDefault();
				activateMain(el.getAttribute('data-switch-main') || 'products', {
					interest: el.getAttribute('data-interest') || undefined,
				});
			});
		});

		shell.querySelectorAll('[data-portal-link="contact"], [data-info-link="contact"]').forEach((el) => {
			el.addEventListener('click', (event) => {
				event.preventDefault();
				activateMain('contact', { interest: el.getAttribute('data-interest') || undefined });
			});
		});

		const hash = window.location.hash.replace(/^#/, '').toLowerCase();
		const productNames = productTabs.map((tab) => (tab.getAttribute('data-product-name') || '').toLowerCase());
		const productIndex = productNames.indexOf(hash);
		if (productIndex >= 0) {
			activateMain('products', { focus: false });
			activateProduct(productIndex, { focus: false });
		} else if (['products', 'work', 'platform', 'open', 'contact'].includes(hash)) {
			activateMain(hash, { focus: false });
		}
	}

	document.querySelectorAll('[data-mt-shell]').forEach((shell) => {
		if (shell instanceof HTMLElement) initShell(shell);
	});
</script>

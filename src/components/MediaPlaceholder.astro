---
interface Props {
	label: string;
	need?: string;
	message?: string;
	/** Optional path once the real file exists, e.g. /media/company/hero/operations.mp4 */
	src?: string;
	kind?: 'image' | 'video';
	aspect?: 'hero' | 'product' | 'story';
	/** Full-bleed, no card chrome */
	bleed?: boolean;
	/** Autoplay muted loop (hero atmosphere) */
	ambient?: boolean;
}

const {
	label,
	need = '',
	message = '',
	src,
	kind = 'image',
	aspect = 'product',
	bleed = false,
	ambient = false,
} = Astro.props;
const isVideo = kind === 'video' || (src && /\.(mp4|webm|mov)$/i.test(src));
const aria = [label, need, message].filter(Boolean).join('. ');
---

<figure
	class:list={['media-ph', `media-ph--${aspect}`, bleed && 'media-ph--bleed']}
	data-media-placeholder
>
	{
		src && !isVideo ? (
			<img src={src} alt={label} class="media-ph-file" width="1600" height="900" loading={aspect === 'hero' ? 'eager' : 'lazy'} decoding="async" />
		) : src && isVideo ? (
			ambient ? (
				<video
					class="media-ph-file"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					src={src}
					aria-label={label}
				/>
			) : (
				<video class="media-ph-file" controls playsinline preload="metadata" src={src}>
					<a href={src}>{label}</a>
				</video>
			)
		) : (
			<div class="media-ph-empty" role="img" aria-label={aria || label} />
		)
	}
</figure>

<style>
	.media-ph {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}
	.media-ph--bleed {
		border-radius: 0;
		border: none;
		background: #050b10;
	}
	.media-ph--hero {
		aspect-ratio: 16 / 9;
		min-height: clamp(18rem, 56vh, 42rem);
	}
	.media-ph--bleed.media-ph--hero {
		aspect-ratio: auto;
		/* Parent hero shell owns the height; fill it edge-to-edge */
		min-height: 100%;
		height: 100%;
	}
	.media-ph--product {
		aspect-ratio: 16 / 10;
	}
	.media-ph--story {
		aspect-ratio: 16 / 10;
	}
	.media-ph-file {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.media-ph-empty {
		height: 100%;
		min-height: inherit;
		background:
			radial-gradient(ellipse 80% 60% at 70% 40%, rgba(46, 184, 166, 0.12), transparent 55%),
			linear-gradient(165deg, #0c1822 0%, #071018 48%, #050b10 100%);
	}
</style>

---
interface SlideshowSlide {
	image: string;
	alt?: string;
}

interface Props {
	slides: SlideshowSlide[];
	lang: 'en' | 'no';
	/** Brukes som tilgjengelig navn på karusellen (f.eks. produktoverskrift) */
	headingLabel: string;
}

const { slides, lang, headingLabel } = Astro.props;

const regionLabel =
	lang === 'no' ? `${headingLabel} – bilder` : `${headingLabel} – images`;
const prevLabel = lang === 'no' ? 'Forrige bilde' : 'Previous slide';
const nextLabel = lang === 'no' ? 'Neste bilde' : 'Next slide';
const goToLabel = lang === 'no' ? 'Gå til bilde' : 'Go to slide';
---

{
	slides.length > 0 ? (
		<div
			class="product-slideshow product-video"
			data-product-slideshow
			role="region"
			aria-roledescription="carousel"
			aria-label={regionLabel}
		>
			<div class="product-slideshow-viewport">
				{slides.map((slide, index) => (
					<figure
						class:list={['product-slideshow-slide', { 'is-active': index === 0 }]}
						data-slide-index={index}
						aria-hidden={index === 0 ? 'false' : 'true'}
					>
						<img
							src={slide.image}
							alt={slide.alt ?? ''}
							class="product-slideshow-img"
							width="960"
							height="540"
							loading={index === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</figure>
				))}
			</div>
			{slides.length > 1 && (
				<>
					<button
						type="button"
						class="product-slideshow-nav product-slideshow-prev"
						data-dir="prev"
					>
						<span class="visually-hidden">{prevLabel}</span>
						<span aria-hidden="true">‹</span>
					</button>
					<button
						type="button"
						class="product-slideshow-nav product-slideshow-next"
						data-dir="next"
					>
						<span class="visually-hidden">{nextLabel}</span>
						<span aria-hidden="true">›</span>
					</button>
					<div class="product-slideshow-dots" role="tablist" aria-label={goToLabel}>
						{slides.map((_, index) => (
							<button
								type="button"
								class:list={['product-slideshow-dot', { 'is-active': index === 0 }]}
								data-slide-to={index}
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								aria-label={`${goToLabel} ${index + 1}`}
							/>
						))}
					</div>
				</>
			)}
		</div>
	) : (
		<div class="product-slideshow-empty product-video video-placeholder">
			<p>{lang === 'no' ? 'Ingen bilder i slideshow' : 'No slideshow images'}</p>
			<span>
				{lang === 'no'
					? 'Legg til productSlideshow i home.no.md'
					: 'Add productSlideshow in home.en.md'}
			</span>
		</div>
	)
}

<style>
	.product-slideshow {
		position: relative;
		width: 100%;
		max-width: none;
		margin-inline: 0;
	}
	.product-slideshow-viewport {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: var(--color-surface-elevated);
	}
	.product-slideshow-slide {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.45s ease, visibility 0.45s ease;
		pointer-events: none;
	}
	.product-slideshow-slide.is-active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		z-index: 1;
	}
	.product-slideshow-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.product-slideshow-nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		transform: translateY(-50%);
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--header-bg);
		backdrop-filter: blur(8px);
		color: var(--color-text);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition: color 0.2s, border-color 0.2s, background 0.2s;
	}
	.product-slideshow-nav:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
	.product-slideshow-prev {
		left: 0.75rem;
	}
	.product-slideshow-next {
		right: 0.75rem;
	}
	.product-slideshow-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
		flex-wrap: wrap;
	}
	.product-slideshow-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		padding: 0;
		border: none;
		background: var(--color-text-muted);
		opacity: 0.45;
		cursor: pointer;
		transition: opacity 0.2s, transform 0.2s, background 0.2s;
	}
	.product-slideshow-dot:hover {
		opacity: 0.85;
	}
	.product-slideshow-dot.is-active {
		opacity: 1;
		background: var(--color-accent);
		transform: scale(1.25);
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.product-slideshow-empty {
		text-align: center;
	}
</style>

<script>
	function initSlideshow(root) {
		const slides = [...root.querySelectorAll('.product-slideshow-slide')];
		const dots = [...root.querySelectorAll('.product-slideshow-dot')];
		const prev = root.querySelector('[data-dir="prev"]');
		const next = root.querySelector('[data-dir="next"]');
		if (slides.length === 0) return;

		let index = 0;
		let timer = null;
		const intervalMs = 6500;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function show(nextIndex: number) {
			const n = ((nextIndex % slides.length) + slides.length) % slides.length;
			index = n;
			slides.forEach((el, i) => {
				const active = i === n;
				el.classList.toggle('is-active', active);
				el.setAttribute('aria-hidden', active ? 'false' : 'true');
			});
			dots.forEach((d, i) => {
				const active = i === n;
				d.classList.toggle('is-active', active);
				d.setAttribute('aria-selected', active ? 'true' : 'false');
			});
		}

		function startAutoplay() {
			if (reducedMotion || slides.length < 2) return;
			stopAutoplay();
			timer = setInterval(() => show(index + 1), intervalMs);
		}

		function stopAutoplay() {
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
		}

		prev?.addEventListener('click', () => {
			stopAutoplay();
			show(index - 1);
			startAutoplay();
		});
		next?.addEventListener('click', () => {
			stopAutoplay();
			show(index + 1);
			startAutoplay();
		});
		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const to = Number(dot.dataset.slideTo);
				if (Number.isFinite(to)) {
					stopAutoplay();
					show(to);
					startAutoplay();
				}
			});
		});

		root.addEventListener('mouseenter', stopAutoplay);
		root.addEventListener('mouseleave', startAutoplay);
		root.addEventListener('focusin', stopAutoplay);
		root.addEventListener('focusout', startAutoplay);

		root.tabIndex = 0;
		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				stopAutoplay();
				show(index - 1);
				startAutoplay();
			} else if (e.key === 'ArrowRight') {
				e.preventDefault();
				stopAutoplay();
				show(index + 1);
				startAutoplay();
			}
		});

		startAutoplay();
	}

	document.querySelectorAll('[data-product-slideshow]').forEach(initSlideshow);
</script>

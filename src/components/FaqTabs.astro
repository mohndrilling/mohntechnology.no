---
interface FaqItem {
	question: string;
	answer: string;
}

interface FaqTab {
	label: string;
	items: FaqItem[];
}

interface Props {
	lang: 'en' | 'no';
	faqTitle: string;
	faqLead?: string;
	faqTabs: FaqTab[];
}

const { lang, faqTitle, faqLead, faqTabs } = Astro.props;
const uid = `faq-${lang}`;
const tablistLabel =
	lang === 'no' ? 'Velg kategori for spørsmål og svar' : 'Choose a category for questions and answers';
---

<section id="faq" class="section faq-section">
	<div class="container">
		<h2 class="section-title">{faqTitle}</h2>
		{faqLead && <p class="section-lead">{faqLead}</p>}
		<div class="faq-tabs-root" data-faq-tabs data-uid={uid}>
			<div class="faq-tablist" role="tablist" aria-label={tablistLabel}>
				{
					faqTabs.map((tab, i) => (
						<button
							type="button"
							class:list={['faq-tab', { 'is-active': i === 0 }]}
							role="tab"
							id={`${uid}-tab-${i}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-controls={`${uid}-panel-${i}`}
							tabindex={i === 0 ? 0 : -1}
							data-tab-index={i}
						>
							{tab.label}
						</button>
					))
				}
			</div>
			{
				faqTabs.map((tab, i) => (
					<div
						class:list={['faq-panel', { 'is-active': i === 0 }]}
						role="tabpanel"
						id={`${uid}-panel-${i}`}
						aria-labelledby={`${uid}-tab-${i}`}
						hidden={i !== 0}
						tabindex={0}
					>
						<dl class="faq-dl">
							{tab.items.map((item) => (
								<>
									<dt class="faq-dt">{item.question}</dt>
									<dd class="faq-dd">{item.answer}</dd>
								</>
							))}
						</dl>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq-section {
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
	}
	.faq-tablist {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}
	.faq-tab {
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 600;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text-muted);
		cursor: pointer;
		transition: color 0.2s, border-color 0.2s, background 0.2s;
	}
	.faq-tab:hover {
		color: var(--color-text);
		border-color: var(--color-text-muted);
	}
	.faq-tab.is-active {
		color: var(--color-bg);
		background: var(--color-accent);
		border-color: var(--color-accent);
	}
	.faq-panel {
		display: none;
	}
	.faq-panel.is-active {
		display: block;
	}
	.faq-panel:focus {
		outline: none;
	}
	.faq-panel:focus-visible {
		box-shadow: 0 0 0 3px var(--color-accent-dim);
		border-radius: var(--radius);
	}
	.faq-dl {
		margin: 0;
	}
	.faq-dt {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--color-text);
		margin: 0 0 0.35rem;
	}
	.faq-dd {
		margin: 0 0 1.5rem;
		padding: 0;
		color: var(--color-text-muted);
		font-size: 0.98rem;
		line-height: 1.6;
		white-space: pre-wrap;
	}
	.faq-dd:last-child {
		margin-bottom: 0;
	}
</style>

<script>
	function initFaqTabs(root) {
		const uid = root.dataset.uid;
		if (!uid) return;
		const tabs = [...root.querySelectorAll('.faq-tab')];
		const panels = [...root.querySelectorAll('.faq-panel')];
		if (tabs.length === 0 || tabs.length !== panels.length) return;

		function activate(index) {
			const n = ((index % tabs.length) + tabs.length) % tabs.length;
			tabs.forEach((tab, i) => {
				const on = i === n;
				tab.classList.toggle('is-active', on);
				tab.setAttribute('aria-selected', on ? 'true' : 'false');
				tab.tabIndex = on ? 0 : -1;
				panels[i].classList.toggle('is-active', on);
				panels[i].hidden = !on;
			});
			tabs[n].focus();
		}

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => activate(i));
			tab.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
					e.preventDefault();
					activate(i + 1);
				} else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
					e.preventDefault();
					activate(i - 1);
				} else if (e.key === 'Home') {
					e.preventDefault();
					activate(0);
				} else if (e.key === 'End') {
					e.preventDefault();
					activate(tabs.length - 1);
				}
			});
		});
	}

	document.querySelectorAll('[data-faq-tabs]').forEach(initFaqTabs);
</script>
